[general]
ignore=body-is-missing
ignore=merge-commit,revert-commit,fixup-commit,squash-commit

[rules]
title-min-length=10
title-max-length=72
title-trailing-whitespace=true
title-trailing-punctuation=true
title-hard-tab=true
title-leading-whitespace=true

body-max-line-length=72
body-trailing-whitespace=true
body-hard-tab=true
body-first-line-empty=true
body-changed-file-mention=true

[title-must-not-contain-word]
words=wip,todo
